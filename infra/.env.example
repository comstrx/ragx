# Project and release identity: a release is named VERSION-<settings revision> unless RELEASE pins a name
PROJECT=
VERSION=
RELEASE=
MIGRATION_POLICY=none
DEPLOY_STRATEGY=blue-green
DEPLOY_DRIVER=compose

# Images pinned by digest
API_IMAGE=
WEB_IMAGES=

# Application env files arrive as API_ENV_FILE (required) and WEB_ENV_FILE (optional), plain or base64, and mount read-only here
API_ENV_MOUNT=/app/.env
WEB_ENV_MOUNT=/app/.env

# API runtime contract: port, storage mount, role commands and the variables the infrastructure owns
API_PORT=8000
API_STORAGE_MOUNT=/app/storage
API_RELEASE_VARIABLE=APP_RELEASE
API_FORCED_ENV=APP_HOST=0.0.0.0 APP_PORT=8000 DB_MIGRATE=false STORAGE_ROOT=/app/storage
API_SERVE_COMMAND=python -m bootstrap serve
API_SERVE_ENV=QUEUE_WORKERS=0 SCHEDULE_ENABLED=false
API_WORK_COMMAND=python -m bootstrap work
API_WORK_ENV=SCHEDULE_ENABLED=false
API_SCHEDULE_COMMAND=python -m bootstrap schedule
API_SCHEDULE_ENV=QUEUE_WORKERS=0 SCHEDULE_ENABLED=true
API_MIGRATE_COMMAND=python -m bootstrap migrate

# Web runtime contract: port, the variables the infrastructure owns and the build-time names of the spec and API URL
WEB_PORT=3000
WEB_FORCED_ENV=PORT=3000 HOSTNAME=0.0.0.0
WEB_SPEC_VARIABLE=NEXT_PUBLIC_SPEC
WEB_API_VARIABLE=SPEC_API_URL

# Domains, replicas and health
API_HOST=
WEB_HOSTS=
API_REPLICAS=2
WORKER_REPLICAS=1
WEB_REPLICAS=
API_READY_PATH=/health
WEB_READY_PATH=/
EXTERNAL_HEALTH_URL=

# Rollout timing, verification and retention
HEALTH_TIMEOUT=120
WARMUP_SECONDS=10
DRAIN_TIMEOUT=30
RETENTION_SECONDS=900
VERIFY_SECONDS=120
VERIFY_FAILURES=3
VERIFY_INTERVAL=5

# Container resources
APP_MEMORY=512m
DATA_MEMORY=512m
EDGE_MEMORY=256m
CPUS=1

# Rate limits as REQUESTS/PERIOD, empty disables
RATE_LIMIT_GLOBAL=
RATE_LIMIT_HOST=
RATE_LIMIT_IP=
RATE_LIMIT_PATHS=

# Edge: EDGE_SOCKETS makes HAProxy serve http.sock and https.sock with the PROXY protocol behind a TCP relay that owns HTTP_PORT and HTTPS_PORT (no HTTP/3); empty publishes those ports on BIND_ADDRESS itself
EDGE_SOCKETS=
BIND_ADDRESS=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
TLS_ENABLED=true
TLS_EMAIL=
TLS_CHALLENGE=http
RENEW_INTERVAL=43200
HTTP3_ENABLED=true
HEALTH_CA=
API_BALANCE=leastconn
WEB_BALANCE=roundrobin
EDGE_MAXCONN=4096
BACKEND_MAXCONN=128
METRICS_ENABLED=false
METRICS_PORT=9090

# Data services provisioned for the application, whose env file repeats the connection values
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_ADMIN_PASSWORD=
DB_MEMORY=128MB
DB_EXTENSIONS=vector
RABBIT_USER=
RABBIT_PASSWORD=
REDIS_PASSWORD=

# GitHub token, used for GHCR pulls and GitHub GitOps reads when REGISTRY_TOKEN or GITOPS_TOKEN is empty
GITHUB_TOKEN=

# Registry pull credentials
REGISTRY_DRIVER=ghcr
REGISTRY_NAMESPACE=
REGISTRY_USER=
REGISTRY_TOKEN=

# GitOps desired state
GITOPS_URL=
GITOPS_USER=
GITOPS_TOKEN=
GITOPS_BRANCH=main
GITOPS_INTERVAL=60
GITOPS_DESIRED=deploy/desired.env
GITOPS_COMPOSE=deploy/application.yaml

# Portainer control plane
PORTAINER_URL=https://localhost:9443
PORTAINER_PORT=9443
PORTAINER_TOKEN=
PORTAINER_ENDPOINT=1
PORTAINER_CA=
PORTAINER_ADMIN_PASSWORD=
PORTAINER_SECRET_KEY=

# Monitoring turns on with a Grafana host
GRAFANA_HOST=
GRAFANA_PASSWORD=
MONITOR_INTERVAL=300
METRICS_RETENTION=15d

# Notifications: each channel turns on with its settings, and a failed delivery is retried NOTIFY_RETRIES times
NOTIFY_RETRIES=2
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
WEBHOOK_URL=
WEBHOOK_SECRET=

# DNS records: DNS_PROVIDER (cloudflare) upserts every routed host to DNS_ADDRESS in DNS_ZONE with DNS_TOKEN and serves TLS_CHALLENGE=dns, and DNS_PROXIED asks it to proxy the records through its network; empty leaves DNS to you
DNS_PROVIDER=
DNS_TOKEN=
DNS_ZONE=
DNS_ADDRESS=
DNS_PROXIED=false

# Proxies in front of the hosts (a CDN or a load balancer): the edge takes the client address from TRUSTED_HEADER only on connections from TRUSTED_PROXIES, CIDRs and https URLs that list them (fetched on edge apply); empty means clients reach the edge directly or through the relay
TRUSTED_PROXIES=
TRUSTED_HEADER=

# Database backups: directory (empty keeps them under the state root), retention in days, interval in seconds; offsite copies turn on with an s3:// (AWS or BACKUP_ENDPOINT) or gs:// (Google Cloud Storage HMAC keys) URI
BACKUP_DIR=
BACKUP_DAYS=14
BACKUP_INTERVAL=86400
BACKUP_MAX_AGE=90000
BACKUP_URI=
BACKUP_ENDPOINT=
BACKUP_REGION=
BACKUP_KEY=
BACKUP_SECRET=

# Remote target over SSH: with SSH_HOST set, server commands run there; SSH_KEY and SSH_KNOWN_HOSTS take a path or the content, plain or base64
SSH_HOST=
SSH_USER=
SSH_PORT=22
SSH_METHOD=auto
SSH_KEY=
SSH_CERTIFICATE=
SSH_PASSWORD=
SSH_KNOWN_HOSTS=
REMOTE_DIR=
