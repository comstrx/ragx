# Release identity: RELEASE pins the name, else VERSION-<revision>

PROJECT=
VERSION=
RELEASE=
MIGRATION_POLICY=none
DEPLOY_STRATEGY=blue-green
DEPLOY_DRIVER=compose

# Images pinned by digest

API_IMAGE=
WEB_IMAGES=

# Application env files (API_ENV_FILE, WEB_ENV_FILE) mount here read-only

API_ENV_MOUNT=/app/.env
WEB_ENV_MOUNT=/app/.env

# API runtime contract owned by the infrastructure

API_PORT=8000
API_STORAGE_MOUNT=/app/storage
API_RELEASE_VARIABLE=APP_RELEASE
API_FORCED_ENV=APP_HOST=0.0.0.0 APP_PORT=8000 DB_MIGRATE=false STORAGE_ROOT=/app/storage
API_SERVE_COMMAND=python -m bootstrap serve
API_SERVE_ENV=QUEUE_WORKERS=0 SCHEDULE_ENABLED=false
API_WORK_COMMAND=python -m bootstrap work
API_WORK_ENV=SCHEDULE_ENABLED=false
API_SCHEDULE_COMMAND=python -m bootstrap schedule
API_SCHEDULE_ENV=QUEUE_WORKERS=0 SCHEDULE_ENABLED=true
API_MIGRATE_COMMAND=python -m bootstrap migrate

# Web runtime contract and the build-time names of the spec and API URL

WEB_PORT=3000
WEB_FORCED_ENV=PORT=3000 HOSTNAME=0.0.0.0
WEB_SPEC_VARIABLE=NEXT_PUBLIC_SPEC
WEB_API_VARIABLE=SPEC_API_URL

# Domains, replicas and health paths

API_HOST=
WEB_HOSTS=
API_REPLICAS=2
WORKER_REPLICAS=1
WEB_REPLICAS=
API_READY_PATH=/health
WEB_READY_PATH=/
EXTERNAL_HEALTH_URL=

# Rollout timing, verification and retention in seconds

HEALTH_TIMEOUT=120
WARMUP_SECONDS=10
DRAIN_TIMEOUT=30
RETENTION_SECONDS=900
VERIFY_SECONDS=120
VERIFY_FAILURES=3
VERIFY_INTERVAL=5

# Container limits

APP_MEMORY=512m
DATA_MEMORY=512m
EDGE_MEMORY=256m
CPUS=1

# Rate limits as REQUESTS/PERIOD; empty disables

RATE_LIMIT_GLOBAL=
RATE_LIMIT_HOST=
RATE_LIMIT_IP=
RATE_LIMIT_PATHS=

# Edge: empty EDGE_SOCKETS publishes the ports, a directory serves a TCP relay

EDGE_SOCKETS=
BIND_ADDRESS=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
TLS_ENABLED=true
TLS_EMAIL=
TLS_CHALLENGE=http
RENEW_INTERVAL=43200
HTTP3_ENABLED=true
HEALTH_CA=
API_BALANCE=leastconn
WEB_BALANCE=roundrobin
EDGE_MAXCONN=4096
BACKEND_MAXCONN=128
METRICS_ENABLED=false
METRICS_PORT=9090

# Data services; the API env file repeats these values

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_ADMIN_PASSWORD=
DB_MEMORY=128MB
DB_EXTENSIONS=vector
RABBIT_USER=
RABBIT_PASSWORD=
REDIS_PASSWORD=

# GitHub token for GHCR pulls and GitOps reads when theirs are empty

GITHUB_TOKEN=

# Registry pull credentials

REGISTRY_DRIVER=ghcr
REGISTRY_NAMESPACE=
REGISTRY_USER=
REGISTRY_TOKEN=

# GitOps desired state; empty GITOPS_URL pushes over SSH

GITOPS_URL=
GITOPS_USER=
GITOPS_TOKEN=
GITOPS_BRANCH=main
GITOPS_INTERVAL=60
GITOPS_DESIRED=deploy/desired.env
GITOPS_COMPOSE=deploy/application.yaml

# Portainer control plane

PORTAINER_URL=https://localhost:9443
PORTAINER_PORT=9443
PORTAINER_TOKEN=
PORTAINER_ENDPOINT=1
PORTAINER_CA=
PORTAINER_ADMIN_PASSWORD=
PORTAINER_SECRET_KEY=

# Monitoring turns on with a Grafana host

GRAFANA_HOST=
GRAFANA_PASSWORD=
MONITOR_INTERVAL=300
METRICS_RETENTION=15d

# Notifications: each channel turns on with its settings

NOTIFY_RETRIES=2
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
WEBHOOK_URL=
WEBHOOK_SECRET=

# DNS records upserted by DNS_PROVIDER (cloudflare); empty leaves DNS to you

DNS_PROVIDER=
DNS_TOKEN=
DNS_ZONE=
DNS_ADDRESS=
DNS_PROXIED=false

# A CDN or load balancer in front: its ranges and client header

TRUSTED_PROXIES=
TRUSTED_HEADER=

# Backups: sql/ dumps, a wal/ point-in-time archive, s3:// or gs:// offsite

BACKUP_DIR=
BACKUP_DAYS=1
BACKUP_INTERVAL=86400
BACKUP_MAX_AGE=90000
BACKUP_WAL=true
BACKUP_ARCHIVE_INTERVAL=300
BACKUP_URI=
BACKUP_ENDPOINT=
BACKUP_REGION=
BACKUP_KEY=
BACKUP_SECRET=

# SSH target: with SSH_HOST set, server commands run there

SSH_HOST=
SSH_USER=
SSH_PORT=22
SSH_METHOD=auto
SSH_KEY=
SSH_CERTIFICATE=
SSH_PASSWORD=
SSH_KNOWN_HOSTS=
REMOTE_DIR=
