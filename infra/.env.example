# Project and release identity
PROJECT=
DEPLOY_ENV=staging
RELEASE=
MIGRATION_POLICY=none
DEPLOY_STRATEGY=blue-green
DEPLOY_DRIVER=portainer

# Images pinned by digest
API_IMAGE=
WEB_IMAGES=

# Domains, replicas and health
API_HOST=
WEB_HOSTS=
API_REPLICAS=2
WORKER_REPLICAS=1
WEB_REPLICAS=
API_READY_PATH=/health
WEB_READY_PATH=/
EXTERNAL_HEALTH_URL=

# Edge
BIND_ADDRESS=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
TLS_ENABLED=true
TLS_EMAIL=
TLS_CHALLENGE=http
HTTP3_ENABLED=true
HEALTH_CA=
METRICS_ENABLED=false

# Application secrets
AUTH_SECRET=
AUTH_KEYS=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_ADMIN_PASSWORD=
RABBIT_USER=
RABBIT_PASSWORD=
REDIS_PASSWORD=

# Application providers
STORAGE_DRIVER=local
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_KEY=
STORAGE_S3_SECRET=
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=
LLM_OPENAI_KEY=
LLM_ANTHROPIC_KEY=
LLM_GEMINI_KEY=
LLM_DEEPSEEK_KEY=
LLM_LOCAL_URL=
LLM_LOCAL_KEY=

# Registry pull credentials
REGISTRY_DRIVER=ghcr
REGISTRY_NAMESPACE=
REGISTRY_USER=
REGISTRY_TOKEN=

# GitOps desired state
GITOPS_URL=
GITOPS_USER=
GITOPS_TOKEN=
GITOPS_BRANCH=main

# Portainer control plane
PORTAINER_URL=https://localhost:9443
PORTAINER_TOKEN=
PORTAINER_ENDPOINT=1
PORTAINER_CA=
PORTAINER_ADMIN_PASSWORD=
PORTAINER_SECRET_KEY=

# Cloudflare DNS
CLOUDFLARE_TOKEN=
CLOUDFLARE_ZONE=
CLOUDFLARE_PROXIED=false
DNS_ADDRESS=

# Backups
BACKUP_DRIVER=local
BACKUP_DAYS=14
BACKUP_S3_URI=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=

# Remote target over SSH
SSH_HOST=
SSH_USER=
SSH_PORT=22
SSH_METHOD=agent
SSH_KEY=
SSH_CERTIFICATE=
SSH_PASSWORD=
SSH_KNOWN_HOSTS=
REMOTE_DIR=

# Notifications
NOTIFY_URL=
NOTIFY_TOKEN=
