ARG NODE_IMAGE=node:26-alpine
ARG BUN_IMAGE=oven/bun:1.4.3-alpine

FROM ${BUN_IMAGE} AS bun

FROM ${NODE_IMAGE} AS base

COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun

ENV NEXT_TELEMETRY_DISABLED=1 \
    CI=1

WORKDIR /app

FROM base AS deps

ARG WEB_DIR=web

COPY ${WEB_DIR}/package.json ${WEB_DIR}/bun.lock ${WEB_DIR}/bunfig.toml ./

RUN bun install --frozen-lockfile

FROM deps AS build

ARG WEB_DIR=web
ARG SPEC
ARG SPEC_API_URL=

ENV NEXT_PUBLIC_SPEC=${SPEC} \
    SPEC_API_URL=${SPEC_API_URL}

COPY ${WEB_DIR}/ ./

RUN test -n "${NEXT_PUBLIC_SPEC}" \
    && bun run build \
    && bun build tools/serve.ts --target=bun --outfile /release/tools/serve.js \
    && rm -rf .next/out/cache \
    && if [ -f .next/out/standalone/server.js ]; then \
         cp -r public .next/out/standalone/public \
         && mkdir -p .next/out/standalone/.next/out \
         && cp -r .next/out/static .next/out/standalone/.next/out/static; \
       fi \
    && mkdir -p .next/out/standalone/.next/cache /release/node_modules/.cache/spec/production \
    && cp -r .next public /release/ \
    && cp node_modules/.cache/spec/production/meta.json /release/node_modules/.cache/spec/production/meta.json

FROM base AS runtime

ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0

COPY --from=build --chown=1000:1000 /release /app

EXPOSE 3000

USER 1000:1000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=30s --start-interval=2s \
    CMD node -e "fetch('http://127.0.0.1:3000/').then((r) => process.exit(r.status < 500 ? 0 : 1)).catch(() => process.exit(1))"

ENTRYPOINT ["bun", "tools/serve.js"]
