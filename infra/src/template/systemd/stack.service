[Unit]
Description=${COMPOSE_PROJECT} platform
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=${SSH_USER}
WorkingDirectory=${SERVER_PATH}
ExecStart=${SERVER_PATH}/infra --config ${SERVER_PATH}/.env -s ${STACK} -y compose up
ExecStop=${SERVER_PATH}/infra --config ${SERVER_PATH}/.env -s ${STACK} -y compose stop
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
