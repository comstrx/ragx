{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "root": true,
  "files": {
    "includes": [
      "**",
      "!public",
      "!.expo",
      "!node_modules",
      "!expo-env.d.ts",
      "!android",
      "!ios",
      "!specs/**/brand/images",
      "!specs/**/brand/fonts",
      "!bun.lock"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "domains": {
      "project": "all",
      "react": "all",
      "reactNative": "all",
      "test": "all"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUndeclaredVariables": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useImportExtensions": "off",
        "noUndeclaredDependencies": "off",
        "useUniqueElementIds": "off"
      },
      "style": {
        "useImportType": "error",
        "noParameterAssign": "error",
        "useConst": "error",
        "noNonNullAssertion": "error",
        "useReactFunctionComponents": "off",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 400
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error"
      },
      "performance": {
        "noJsxPropsBind": "off"
      },
      "a11y": "error",
      "security": {
        "recommended": true,
        "noSecrets": "off"
      },
      "complexity": {
        "recommended": true,
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 6
          }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "globals": ["Bun"]
  },
  "overrides": [
    {
      "includes": [
        "src/lib/spec/config.ts",
        "src/lib/spec/runtime.ts",
        "src/types/spec.d.ts",
        "src/render/blocks.tsx",
        "src/lib/spec/world.ts",
        "src/lib/spec/emoji.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["src/render/**"],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    },
    {
      "includes": ["src/lib/providers/console.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
