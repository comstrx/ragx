# Release identity: RELEASE pins the name, else VERSION-<revision>

PROJECT=
VERSION=
RELEASE=
MIGRATION_POLICY=none
DEPLOY_STRATEGY=blue-green
DEPLOY_DRIVER=compose

# Domains of each part in src/config/parts.sh, separated by spaces or commas; empty leaves the part out

API_DOMAIN=
SUPER_DOMAIN=
ADMIN_DOMAIN=
SUPPLIER_DOMAIN=
VENDOR_DOMAIN=
DELIVERY_DOMAIN=
CLIENT_DOMAIN=
TENANT_DOMAIN=

# Dynamic domains: an https endpoint listing domains and their parts (shape in src/config/domains.sh), its token and the sync period in seconds; off unless all three are set and the period is above 0

DOMAINS_ENDPOINT=
DOMAINS_TOKEN=
DOMAINS_INTERVAL=3600 # 1 hour
DOMAINS_MAX_DROP=25

# Server part runtime contract owned by the infrastructure

API_STORAGE_MOUNT=/app/storage
API_RELEASE_VARIABLE=APP_RELEASE
API_FORCED_ENV=APP_HOST=0.0.0.0 APP_PORT=8000 DB_MIGRATE=false STORAGE_ROOT=/app/storage
API_SERVE_COMMAND=python -m bootstrap serve
API_SERVE_ENV=QUEUE_WORKERS=0 SCHEDULE_ENABLED=false
API_WORK_COMMAND=python -m bootstrap work
API_WORK_ENV=SCHEDULE_ENABLED=false
API_SCHEDULE_COMMAND=python -m bootstrap schedule
API_SCHEDULE_ENV=QUEUE_WORKERS=0 SCHEDULE_ENABLED=true
API_MIGRATE_COMMAND=python -m bootstrap migrate

# Background replicas and an optional external probe

WORKER_REPLICAS=1
EXTERNAL_HEALTH_URL=

# Rollout timing, verification and retention; every duration in this file is in seconds

HEALTH_TIMEOUT=120 # 2 minutes
WARMUP_SECONDS=10 # 10 seconds
DRAIN_TIMEOUT=30 # 30 seconds
RETENTION_SECONDS=900 # 15 minutes
VERIFY_SECONDS=120 # 2 minutes
VERIFY_FAILURES=3
VERIFY_INTERVAL=5 # 5 seconds

# Container limits

APP_MEMORY=512m
DATA_MEMORY=512m
EDGE_MEMORY=256m
CPUS=1

# Rate limits as REQUESTS/PERIOD; empty disables

RATE_LIMIT_GLOBAL=
RATE_LIMIT_IP=
RATE_LIMIT_PATHS=

# Edge: empty EDGE_SOCKETS publishes the ports, a directory serves a TCP relay

EDGE_SOCKETS=
BIND_ADDRESS=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
TLS_ENABLED=true
TLS_EMAIL=
TLS_STAGING=false
RENEW_INTERVAL=43200 # 12 hours
HTTP3_ENABLED=true
HEALTH_CA=
EDGE_MAXCONN=4096
BACKEND_MAXCONN=128
METRICS_ENABLED=false
METRICS_PORT=9090

# Certificates: new ones issued per run, the wait after a failed one, and how long one outlives its last domain

CERTIFICATE_BATCH=100
CERTIFICATE_RETRY=3600 # 1 hour
CERTIFICATE_RETENTION=604800 # 7 days

# Data services; the API env file repeats these values

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_ADMIN_PASSWORD=
DB_MEMORY=128MB
DB_EXTENSIONS=vector
RABBIT_USER=
RABBIT_PASSWORD=
REDIS_PASSWORD=

# GitHub token for GHCR pulls and GitOps reads when theirs are empty

GITHUB_TOKEN=

# Registry pull credentials

REGISTRY_DRIVER=ghcr
REGISTRY_NAMESPACE=
REGISTRY_USER=
REGISTRY_TOKEN=

# GitOps desired state; empty GITOPS_URL pushes over SSH

GITOPS_URL=
GITOPS_USER=
GITOPS_TOKEN=
GITOPS_BRANCH=main
GITOPS_INTERVAL=60 # 1 minute
GITOPS_DESIRED=deploy/desired.env
GITOPS_COMPOSE=deploy/application.yaml

# Portainer control plane

PORTAINER_URL=https://localhost:9443
PORTAINER_PORT=9443
PORTAINER_TOKEN=
PORTAINER_ENDPOINT=1
PORTAINER_CA=
PORTAINER_ADMIN_PASSWORD=
PORTAINER_SECRET_KEY=

# Monitoring turns on with a Grafana domain

GRAFANA_DOMAIN=
GRAFANA_PASSWORD=
MONITOR_INTERVAL=300 # 5 minutes
METRICS_RETENTION=1296000 # 15 days

# Self-hosted models of the models table: MODELS names the ones to serve

MODELS=
MODELS_DIR=
MODELS_TOKEN=

# Notifications: each channel turns on with its settings

NOTIFY_RETRIES=2
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
WEBHOOK_URL=
WEBHOOK_SECRET=

# A proxy or load balancer in front: its ranges and client header

TRUSTED_PROXIES=
TRUSTED_HEADER=

# Backups: sql/ dumps, a wal/ point-in-time archive, s3:// or gs:// offsite

BACKUP_DIR=
BACKUP_RETENTION=86400 # 1 day
BACKUP_INTERVAL=3600 # 1 hour
BACKUP_MAX_AGE=7200 # 2 hours
BACKUP_WAL=true
BACKUP_ARCHIVE_INTERVAL=300 # 5 minutes
BACKUP_URI=
BACKUP_ENDPOINT=
BACKUP_REGION=
BACKUP_KEY=
BACKUP_SECRET=

# SSH target: with SSH_HOST set, server commands run there

SSH_HOST=
SSH_USER=
SSH_PORT=22
SSH_METHOD=auto
SSH_KEY=
SSH_CERTIFICATE=
SSH_PASSWORD=
SSH_KNOWN_HOSTS=
REMOTE_DIR=
