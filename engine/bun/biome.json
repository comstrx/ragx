{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "root": true,
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.bun",
      "!bun.lock",
      "!**/*.d.ts",
      "!packages/world/asset",
      "!packages/world/data"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "domains": {
      "project": "all",
      "react": "all",
      "test": "all"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUndeclaredVariables": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useImportExtensions": "off",
        "noUndeclaredDependencies": "off",
        "useUniqueElementIds": "off",
        "useExhaustiveDependencies": "off"
      },
      "style": {
        "useImportType": "error",
        "noParameterAssign": "error",
        "useConst": "error",
        "noNonNullAssertion": "error",
        "useReactFunctionComponents": "off",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 400
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error"
      },
      "a11y": "error",
      "security": {
        "recommended": true,
        "noSecrets": "off"
      },
      "complexity": {
        "recommended": true,
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 6
          }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "globals": ["Bun"]
  },
  "overrides": [
    {
      "includes": ["packages/**", "!packages/tooling/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Bun": "packages are runtime-agnostic",
                  "process": "packages are runtime-agnostic",
                  "Buffer": "packages are runtime-agnostic",
                  "require": "packages are runtime-agnostic"
                }
              }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["bun", "bun:*", "bun:*/**", "node:*", "node:*/**"],
                    "message": "packages are runtime-agnostic"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
