APP_NAME=RagX
APP_ENV=local
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PREFIX=/v1
APP_URL=
APP_PORT=8000
APP_WORKERS=1
APP_RELEASE=
APP_ORIGINS=["http://localhost:3000","http://localhost:3001"]
LOG_LEVEL=info
LOG_FILE=
LOG_RENDERER=console
DB_DRIVER=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ragx
DB_USERNAME=ragx
DB_PASSWORD=
DB_SSLMODE=prefer
DB_SEARCH_PATH=public
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_TIMEOUT=5
DB_MIGRATE=true
DB_SEED=false
AUTH_SECRET=
AUTH_ALGORITHM=HS256
AUTH_ISSUER=ragx
AUTH_ACCESS_TTL=900
AUTH_REFRESH_TTL=2592000
AUTH_KEYS=[]
MAIL_DRIVER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TLS=true
MAIL_SSL=false
MAIL_VERIFY=true
MAIL_SENDER=hello@ragx.test
MAIL_NAME=RagX
DOCS_ENABLED=true
DOCS_PATH=/docs
DOCS_OPENAPI=/openapi.json
DOCS_THEME=default
DOCS_LAYOUT=modern
DOCS_ERRORS=true
DOCS_SERVERS=[]
DOCS_TAGS=[]
DOCS_HIDE=[]
STORAGE_DISK=public
STORAGE_ROOT=src/storage
STORAGE_PUBLIC=app/public
STORAGE_PRIVATE=app/private
STORAGE_LOGS=logs
STORAGE_URL=/storage
STORAGE_PATTERN={Y}/{m}/{d}
STORAGE_MAX_SIZE=10485760
STORAGE_ALLOWED=[]
STORAGE_BLOCKED=["html","htm","svg","js","php","sh","exe"]
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_KEY=
STORAGE_S3_SECRET=
STORAGE_S3_PREFIX=
STORAGE_S3_URL=
STORAGE_S3_PATH_STYLE=false
QUEUE_DRIVER=memory
QUEUE_URL=amqp://guest:guest@127.0.0.1:5672/
QUEUE_EXCHANGE=jobs
QUEUE_PREFETCH=16
QUEUE_WORKERS=2
QUEUE_TRIES=3
QUEUE_BACKOFF=1.0
QUEUE_QUEUES=["default","maintenance"]
SCHEDULE_ENABLED=true
SCHEDULE_TICK=1.0
SCHEDULE_TIMEZONE=UTC
SOCKET_ENABLED=true
SOCKET_PATH=/ws
SOCKET_CONNECTIONS=10000
SOCKET_QUEUE=256
SOCKET_FRAME=65536
SOCKET_PING=25.0
SOCKET_DROPS=64
BROADCAST_ENABLED=true
BROADCAST_DRIVER=local
ASSETS_FOLDER=src/public
ASSETS_URL=/assets
ASSETS_CACHE=31536000
ASSETS_VERSIONED=true
CACHE_DRIVER=memory
CACHE_URL=redis://127.0.0.1:6379/0
CACHE_PREFIX=ragx
CACHE_TTL=300
EVENT_DRIVER=local
EVENT_URL=amqp://guest:guest@127.0.0.1:5672/
EVENT_EXCHANGE=events
EVENT_QUEUE=
EVENT_PREFETCH=32
