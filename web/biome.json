{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "root": true,
  "files": {
    "includes": [
      "**",
      "!.next",
      "!node_modules",
      "!next-env.d.ts",
      "!public",
      "!specs/**/brand/images",
      "!specs/**/brand/fonts",
      "!bun.lock",
      "!**/*.d.ts",
      "!src/lib/std/world/asset",
      "!src/lib/std/world/data"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "domains": {
      "project": "all",
      "next": "all",
      "react": "all",
      "test": "all"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUndeclaredVariables": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useImportExtensions": "off",
        "noUndeclaredDependencies": "off",
        "useUniqueElementIds": "off"
      },
      "style": {
        "useImportType": "error",
        "noParameterAssign": "error",
        "useConst": "error",
        "noNonNullAssertion": "error",
        "useReactFunctionComponents": "off",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 400
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error"
      },
      "performance": {
        "noImgElement": "off",
        "noJsxPropsBind": "off"
      },
      "a11y": "error",
      "security": {
        "recommended": true,
        "noSecrets": "off"
      },
      "complexity": {
        "recommended": true,
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 6
          }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "globals": ["Bun"]
  },
  "overrides": [
    {
      "includes": [
        "src/lib/spec/config.ts",
        "src/lib/spec/runtime.ts",
        "src/lib/spec/browser.ts",
        "src/types/spec.d.ts",
        "src/app/(web)/\\[locale\\]/layout.tsx",
        "src/app/(web)/\\[locale\\]/\\[\\[...path\\]\\]/mount.ts",
        "src/app/(web)/\\[locale\\]/\\[\\[...path\\]\\]/warm.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off",
            "noUndeclaredDependencies": "off"
          }
        }
      }
    },
    {
      "includes": ["src/app/**"],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "off"
          },
          "correctness": {
            "noUnresolvedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["src/lib/std/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": "off"
          }
        }
      }
    },
    {
      "includes": ["src/elements/jsonld.tsx"],
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    },
    {
      "includes": ["src/lib/spec/surface.ts"],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off"
          }
        }
      }
    }
  ]
}
